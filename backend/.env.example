# Copy to backend/.env. Replace placeholders locally; never commit .env.
APP_ENV=local
PUBLIC_ORIGIN=http://localhost:8000
COOKIE_SECURE=false
AUTH_SESSION_MAX_AGE_SECONDS=28800
# MVP defaults approved for implementation on 18.10.2026; configurable.
# IP comes from ASGI scope. Configure trusted reverse proxy separately.
LOGIN_IP_ATTEMPTS=30
LOGIN_IP_WINDOW_SECONDS=60
LOGIN_FAILED_ATTEMPTS=5
LOGIN_FAILURE_WINDOW_SECONDS=300
# Chat limits approved on 18.10.2026. One worker/replica is required.
CHAT_MESSAGE_MAX_CHARACTERS=8000
CHAT_STATE_MAX_BYTES=131072
CHAT_SESSIONS_PER_AUTH=10
CHAT_SESSIONS_TOTAL=1000
CHAT_MESSAGES_PER_SESSION=200
CHAT_REQUEST_TIMEOUT_SECONDS=300
LLM_RESPONSE_MAX_BYTES=1048576
# Import limits approved on 21.10.2026.
IMPORT_MAX_FILE_BYTES=20971520
IMPORT_MAX_REQUEST_BYTES=22020096
IMPORT_MAX_FEATURES=10000
IMPORT_MAX_POSITIONS=500000
IMPORT_MAX_POSITIONS_PER_GEOMETRY=100000
IMPORT_TIMEOUT_SECONDS=300
IMPORT_LOCK_TIMEOUT_SECONDS=10
# Trusted read-only directory, configured by the operator; no HTTP path input.
# Set only after accepting the six-file 500+4 package and manifest.json.
# DEMO_PACKAGE_DIR=../data/demo
# Leave unset until the trusted MLChat package/runtime/model are supplied.
# DIALOGUE_FACTORY=mlchat.integration:create_dialogue
# LLM_BASE_URL=http://llm:PORT/v1
# LLM_MODEL=MODEL_ID
# Optional OpenAI-compatible temperature, 0-2; leave unset for runtime default.
# The MLChat Ollama profile requires an explicit 0 in the HTTP request.
# LLM_TEMPERATURE=0
# LLM_API_KEY=
# text_json/json_object/json_schema: choose after runtime compatibility check.
LLM_RESPONSE_MODE=text_json
DATABASE_URL=postgresql+asyncpg://gis_runtime:REPLACE_ME@localhost:5432/gis
# Alembic reads this from the process environment; it does not read .env.
MIGRATION_DATABASE_URL=postgresql+asyncpg://gis_migrator:REPLACE_ME@localhost:5432/gis
